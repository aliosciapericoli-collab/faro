SUPABASE_URL=""

# Solo in .env.local — mai nel repo. Serve lato server per leggere/scrivere
# nel vault delle credenziali (vault.create_secret / vault.decrypted_secrets).
SUPABASE_SERVICE_ROLE_KEY=""
