# Copia questo file in .env (valori pubblici) e .env.local (service role, mai committata).

# Progetto Supabase dedicato a Faro (NON riusare quello di Discernia:
# Faro conserva credenziali di più proprietà, meglio isolarlo).
VITE_SUPABASE_URL=""
